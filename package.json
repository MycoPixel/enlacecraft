{
  "name": "enlacecraft",
  "author": {
    "name": "Paulo Castro",
    "email": "paulo.castro@usach.cl"
  },
  "desktopName": "enlacecraft.desktop",
  "version": "1.9.2",
  "description": "A browser-based molecule drawing application.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "check": "npm run lint && tsc -b && vitest run",
    "deploy": "npm run build && gh-pages -d dist",
    "electron:dev": "concurrently -k -s first \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:preview": "npm run build && electron .",
    "check:backends": "node scripts/check-backends.mjs",
    "predist": "npm run check:backends",
    "predist:win": "npm run check:backends",
    "predist:linux": "npm run check:backends",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --win --linux"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.28.0",
    "openchemlib": "^9.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mycopixel.enlacecraft",
    "productName": "EnlaceCraft",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": {
      "provider": "github",
      "owner": "MycoPixel",
      "repo": "enlacecraft-releases"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/nmrgraph_server",
        "to": "nmrgraph_server"
      },
      {
        "from": "resources/structure3d_server",
        "to": "structure3d_server"
      },
      {
        "from": "resources/iupac_fallback_server",
        "to": "iupac_fallback_server"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "A browser-based molecule drawing application.",
      "syncDesktopName": true
    }
  }
}
