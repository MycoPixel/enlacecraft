# Python
__pycache__/
*.pyc
*.egg-info/

# Virtual environments (conda envs normally live outside the repo,
# but ignore these in case one ever gets created inside it)
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Models - checkpoints are large binaries, regenerated by training,
# not something to commit. *.pt is a belt-and-suspenders catch-all on
# top of data/models/ below, in case a checkpoint ever ends up
# somewhere else (e.g. copied out for a manual smoke test).
*.joblib
*.pt

# Data
data/raw/
data/processed/
data/models/

# PyInstaller build output (the packaging/*.spec and packaging/README.md
# SOURCE files are NOT ignored - only what pyinstaller generates when
# you run it, which already lands in build/ and dist/ below, same as
# any other Python package build).
build/
dist/

# macOS
.DS_Store

# Windows
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Pytest
.pytest_cache/

# Environment files
.env
.env.*
!.env.example
