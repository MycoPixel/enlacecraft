   "source": [
    "from rdkit import Chem\n",
    "\n",
    "smiles = \"CCO\"\n",
    "\n",
    "mol = Chem.MolFromSmiles(smiles)\n",
    "\n",
    "print(\"Atoms:\")\n",
    "for atom in mol.GetAtoms():\n",
    "    print(atom.GetIdx(), atom.GetSymbol())"
   ]
